# Agent-Mesh — configuración (copia a .env y rellena)
# Postgres de TrueNAS: host, base, usuario, password
KB_DSN=postgresql://kb:***@192.168.0.X:5432/agentmesh
# Token para que los agentes se autentiquen (vacío = sin auth). Legacy: un solo token.
KB_TOKEN=cambia_este_token
# F3 — tokens por agente (JSON). Si está definido, gana a KB_TOKEN.
# KB_TOKENS={"hermes":"tok_hermes","mako":"tok_mako","jarvis":"tok_jarvis"}
# Redis de coordinación (bus existing Hermes<->Mako). Opcional: vacío = sin avisos
KB_REDIS_URL=redis://192.168.0.46:6379/0
# Canal pub/sub de avisos de cambios
KB_CHANNEL=kb:changes
# Puerto del servicio
KB_PORT=8084
# F2 — intervalo del barrendero TTL en segundos (por defecto 300 = 5 min)
KB_TTL_SWEEP=300
